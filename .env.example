# ==============================================================================
# RareFinds Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file with secrets to Git.

# ------------------------------------------------------------------------------
# 1. DATABASE (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# In your Supabase Dashboard:
# 1. Click the green "Connect" button at the top header of your project.
# 2. Select "Prisma" or "Transaction pooler".
#
# DATABASE_URL: Pooled connection string (Port 6543 with ?pgbouncer=true or pooler mode)
# Used by the application at runtime for query pooling.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct database connection string (Port 5432)
# Used by Prisma CLI for running migrations and schema pushes.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Generate with: `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET="your-32-character-random-secret-key-here"
AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. SUPABASE STORAGE (Public / Private Object Storage for Shoe Images)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="sneakers"

# ------------------------------------------------------------------------------
# 4. PAYMENTS & TESTING
# ------------------------------------------------------------------------------
# Set to "true" to allow simulated checkout testing in non-production environments
ENABLE_TEST_PAYMENTS="true"

# Found in: PayMongo Dashboard -> Developers -> API Keys (Phase 4b)
PAYMONGO_SECRET_KEY="sk_test_your_secret_key"
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY="pk_test_your_public_key"
PAYMONGO_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# ------------------------------------------------------------------------------
# 5. ADMIN CREDENTIALS (For Initial Seeding)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL="admin@rarefinds.ph"
INITIAL_ADMIN_PASSWORD="ChangeMe123!RareFinds"
INITIAL_ADMIN_NAME="RareFinds Store Owner"
